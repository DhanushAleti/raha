# Supabase project (create at https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the client bundle. Used by seed script only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL used in auth redirects (http://localhost:3000 for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the landing-page CTA (country code, no +, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# UPI VPA that collects the Rs 2,000 diagnostic (e.g. yourname@okhdfcbank).
# Leave unset and every pay button falls back to WhatsApp — nothing breaks,
# but nobody can pay, which is the one thing that has to be testable.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=Raha
